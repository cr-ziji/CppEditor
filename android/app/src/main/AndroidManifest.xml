<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/x-c" />
                <data android:mimeType="text/x-csrc" />
                <data android:mimeType="text/x-c++" />
                <data android:mimeType="text/x-c++src" />
                <data android:mimeType="text/x-chdr" />
                <data android:mimeType="text/x-c++hdr" />
                <data android:mimeType="text/plain" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.cpp" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.c" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.h" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.cc" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.cxx" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.hpp" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.cpp" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.c" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.h" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.cc" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.cxx" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.hpp" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
