{
  "name": "CppEditor",
  "version": "1.0.0",
  "description": "更现代的C++编辑器",
  "main": "main.js",
  "author": "cyp",
  "license": "GNUV3",
  "homepage": "https://github.com/cr-ziji/CppEditor",
  "repository": {
    "type": "git",
    "url": "https://github.com/cr-ziji/CppEditor.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "postinstall": "npm run sync-vendor && electron-builder install-app-deps",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "sync-vendor": "node scripts/sync-vendor.js"
  },
  "dependencies": {
    "electron-window-state": "^5.0.3"
  },
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "monaco-editor": "^0.56.0",
    "vscode-jsonrpc": "^9.0.1",
    "vscode-languageserver-protocol": "^3.18.2"
  },
  "build": {
    "electronLanguages": [
      "zh-CN"
    ],
    "files": [
      "**/*",
      "!resources/clangd/**",
      "!resources/mingw/**",
      "!resources/gcc/**",
      "!CppProject/**",
      "!android/**"
    ],
    "extraResources": [
      {
        "from": "./resources/clangd",
        "to": "clangd"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png",
      "extraResources": [
        {
          "from": "./resources/mingw",
          "to": "mingw"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Development",
      "maintainer": "cyp <cr-ziji@users.noreply.github.com>",
      "synopsis": "更现代的 C++ 编辑器",
      "description": "CppEditor 是一款内置 clangd 与 GCC 工具链的现代 C++ 编辑器。",
      "desktop": {
        "entry": {
          "Name": "CppEditor",
          "Comment": "更现代的 C++ 编辑器",
          "Categories": "Development;IDE;"
        }
      },
      "fileAssociations": [
        {
          "ext": "c",
          "name": "C Source File",
          "mimeType": "text/x-csrc"
        },
        {
          "ext": "cpp",
          "name": "C++ Source File",
          "mimeType": "text/x-c++src"
        },
        {
          "ext": "h",
          "name": "C/C++ Header File",
          "mimeType": "text/x-chdr"
        }
      ],
      "extraResources": [
        {
          "from": "./resources/gcc",
          "to": "gcc"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    }
  },
  "allowScripts": {
    "electron@41.10.7": true,
    "electron-winstaller@5.4.0": true
  }
}
